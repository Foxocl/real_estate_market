<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".NewItemFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:text="@string/new_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Transaction type selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/transaction_type_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/transactionTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/radioSale"
                style="@style/TransactionTypeRadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/sale"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioRent"
                style="@style/TransactionTypeRadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/rent" />
        </RadioGroup>

        <!-- Property type selection (existing) -->
        <RelativeLayout
            android:id="@+id/layoutPropertyType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/iconTheme"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/outline_apartment_24"
                android:contentDescription="@string/icon_theme_desc"
                app:tint="?android:attr/textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/iconTheme"
                android:layout_toStartOf="@id/arrowTheme"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/prop_label"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/prop_placeholder"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/arrowTheme"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/arrow_up_float"
                app:tint="?android:attr/textColorSecondary"
                android:rotation="90"
                android:importantForAccessibility="no" />
        </RelativeLayout>

        <!-- Rooms and floor side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Rooms -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rooms_label"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etRooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/prop_placeholder"
                    android:inputType="number"
                    android:maxLines="1"
                    android:paddingVertical="12dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bottom_border" />
            </LinearLayout>

            <!-- Floor -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/floor_label"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etFloor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/prop_placeholder"
                    android:inputType="number"
                    android:maxLines="1"
                    android:paddingVertical="12dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bottom_border" />
            </LinearLayout>
        </LinearLayout>

        <!-- Locality -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/locality_label"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <EditText
                    android:id="@+id/etLocality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/prop_placeholder"
                    android:maxLines="1"
                    android:paddingVertical="12dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bottom_border" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Street -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/street_label"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <EditText
                    android:id="@+id/etStreet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/prop_placeholder"
                    android:maxLines="1"
                    android:paddingVertical="12dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bottom_border" />
            </LinearLayout>
        </RelativeLayout>

        <!-- House number -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/house_label"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <EditText
                    android:id="@+id/etHouseNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/prop_placeholder"
                    android:maxLines="1"
                    android:paddingVertical="12dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bottom_border" />
            </LinearLayout>
        </RelativeLayout>
        <!-- Negotiable selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/negotiable_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/negotiableGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/radioNegotiableYes"
                style="@style/TransactionTypeRadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/negotiable_yes"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioNegotiableNo"
                style="@style/TransactionTypeRadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/negotiable_no" />
        </RadioGroup>

        <!-- Price -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/price_label"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <EditText
                    android:id="@+id/etPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/prop_placeholder"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:paddingVertical="12dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bottom_border" />
            </LinearLayout>
        </RelativeLayout>
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/save"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            style="@style/Widget.Material3.Button" />
    </LinearLayout>
</ScrollView>